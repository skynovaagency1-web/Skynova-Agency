# Copy to `.env` and paste your key after the `=`.
#
#   cp .env.example .env
#
# `.env` is gitignored (root .gitignore:15) and bun loads it automatically,
# so the key never reaches your shell history, your screen, or a chat window.
#
# Prefer a RESTRICTED key (rk_) with write access to Customers and Invoices
# only: https://dashboard.stripe.com/apikeys
# A sandbox from `stripe sandbox create` issues a secret key (sk_test_),
# which is fine for testing.
STRIPE_RESTRICTED_KEY=
